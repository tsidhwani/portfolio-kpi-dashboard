# DATABASE_URL is read by BOTH the Prisma CLI and the Next.js runtime.
# The Prisma CLI only loads `.env` (not `.env.local`), so for local dev put
# DATABASE_URL in `.env` and the app secrets below in `.env.local`.
# Local Postgres example: postgresql://<you>@localhost:5432/portfolio_kpi_dev?schema=public
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js v5 reads AUTH_SECRET (NEXTAUTH_SECRET is the legacy name).
AUTH_SECRET="generate with: openssl rand -base64 32"

# --- Google OAuth (production sign-in) --------------------------------------
# Optional for local/demo use. If unset, the "Continue with Google" button
# is hidden and only demo login is offered.
# Google Cloud Console -> Credentials -> OAuth client ID.
# Authorized redirect URI (local): http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Demo login ----------------------------------------------------------
# One-click "sign in as Admin / Partner / Deal team / CFO" using the seeded
# users — no Google account needed. Defaults: ON in dev, OFF in production.
#   DEMO_LOGIN=1  force on  (e.g. a hosted demo)
#   DEMO_LOGIN=0  force off
DEMO_LOGIN=""

# --- Document storage --------------------------------------------------------
# If set, uploads go to Vercel Blob; otherwise to a gitignored ./.uploads dir.
BLOB_READ_WRITE_TOKEN=""
