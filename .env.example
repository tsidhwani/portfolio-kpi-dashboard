# DATABASE_URL is read by BOTH the Prisma CLI and the Next.js runtime.
# The Prisma CLI only loads `.env` (not `.env.local`), so for local dev put
# DATABASE_URL in `.env` and the app secrets below in `.env.local`.
# Local Postgres example: postgresql://<you>@localhost:5432/portfolio_kpi_dev?schema=public
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Auth.js v5 reads AUTH_SECRET (NEXTAUTH_SECRET is the legacy name).
AUTH_SECRET="generate with: openssl rand -base64 32"
# Google OAuth client (Google Cloud Console -> Credentials -> OAuth client ID).
# Authorized redirect URI for local dev: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
BLOB_READ_WRITE_TOKEN=""
